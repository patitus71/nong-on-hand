// Prisma schema สำหรับ Task Board App
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  QA_LEAD
  QA_MANAGER
  QA_ENGINEER
}

enum TaskSource {
  MANUAL
  IMPORTED
}

enum BoardType {
  PERSONAL
  SQUAD
  ROLE
}

enum RetroCategory {
  WENT_WELL
  TO_IMPROVE
  ACTION_ITEM
}

enum RetroStatus {
  OPEN
  CLOSED
}

enum TimeLogSource {
  AUTO
  MANUAL
}

enum SprintStatus {
  OPEN
  CLOSED
}

model Squad {
  id             String        @id @default(cuid())
  name           String        @unique
  isFloatingPool Boolean       @default(false)
  users          User[]
  tasks          Task[]
  retros         Retro[]
  importBatches  ImportBatch[]
  weeklyReports  WeeklyReport[]
  sprints        Sprint[]
  createdAt      DateTime      @default(now())

  @@index([isFloatingPool])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         Role      @default(QA_ENGINEER)
  active       Boolean   @default(true) // admin ปิดการใช้งาน user ได้โดยไม่ต้องลบ
  deletedAt    DateTime? // soft-delete: null = active, set = ถูกลบโดย admin
  squadId      String?
  squad        Squad?    @relation(fields: [squadId], references: [id])
  boards       Board[]
  assignedTasks Task[]   @relation("AssigneeTasks")
  timeLogs     TimeLog[]
  retroItemsAuthored RetroItem[]
  retroItemsOwned    RetroItem[] @relation("RetroItemOwner")
  retroVotes   RetroVote[]
  importBatches ImportBatch[]
  flaggedIssueLogs  TaskIssueLog[] @relation("IssueFlaggedBy")
  resolvedIssueLogs TaskIssueLog[] @relation("IssueResolvedBy")
  taskLogs          TaskLog[]
  flaggedTasksForDeletion Task[]         @relation("TaskDeletionFlaggedBy")
  reviewedTasks           Task[]         @relation("TaskReviewApprovedBy")
  deletedTasks            Task[]         @relation("TaskDeletedBy")
  notifications           Notification[]
  weeklyReports           WeeklyReport[] @relation("WeeklyReportGeneratedBy")
  sprintsClosed           Sprint[]       @relation("SprintClosedBy")
  createdAt    DateTime  @default(now())

  @@index([squadId, active])
  @@index([role, squadId, active])
}

model Board {
  id        String    @id @default(cuid())
  name      String
  type      BoardType @default(PERSONAL)
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  lanes     Lane[]
  createdAt DateTime  @default(now())

  @@index([ownerId, type])
}

// เลนแบบ Jira ที่ user สร้าง/จัดเรียงเองได้
model Lane {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String // เช่น To Do, Doing, Review, Done
  order   Int    @default(0)
  tasks   Task[]
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  squadId       String?
  squad         Squad?    @relation(fields: [squadId], references: [id])
  assigneeId    String?
  assignee      User?     @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  laneId        String?
  lane          Lane?     @relation(fields: [laneId], references: [id])
  order         Int       @default(0)
  isMultiWeek   Boolean   @default(false) // งานใหญ่ข้ามสัปดาห์
  hasIssue      Boolean   @default(false) // สถานะปัจจุบัน ไม่ใช่ประวัติ
  issueNote     String?   // โน้ตปัญหาปัจจุบัน
  source        TaskSource @default(MANUAL) // MANUAL = สร้างเอง, IMPORTED = มาจาก import CSV/Excel
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  estimatedHours    Float?    // เวลาประมาณการ (ชั่วโมง รองรับทศนิยม เช่น 1.5) — กำหนดตอนดึงงานเข้าบอร์ด
  dueDate           DateTime? // วันที่คาดว่าจะเสร็จ — กรอกตอนดึงงานเข้าบอร์ด
  pulledIntoBoardAt DateTime? // เวลาที่ถูกดึงจาก "งานทั้งหมด" เข้าบอร์ดจริง (null = ยังอยู่ในกองรวม)
  deletedAt         DateTime? // soft-delete: null = active, set = ถูกลบ
  deletedById       String?   // คนที่กดลบจริง — ใช้โชว์ "ลบโดย + Role" ใน Weekly Report
  deletedBy         User?     @relation("TaskDeletedBy", fields: [deletedById], references: [id])
  flaggedForDeletion    Boolean   @default(false) // QA_LEAD flag งานนี้ให้ลบ (เหตุผลอยู่ใน deletionFlagNote)
  deletionFlagNote      String?   // เหตุผลที่ QA_LEAD flag
  deletionFlaggedById   String?
  deletionFlaggedBy     User?     @relation("TaskDeletionFlaggedBy", fields: [deletionFlaggedById], references: [id])
  deletionFlaggedAt     DateTime?
  reviewApprovedAt      DateTime? // เวลาที่ QA_LEAD อนุมัติ review (null = ยังไม่ผ่าน)
  reviewApprovedById    String?
  reviewApprovedBy      User?     @relation("TaskReviewApprovedBy", fields: [reviewApprovedById], references: [id])
  completedAt           DateTime? // set ตอนย้ายเข้าเลน Done (update ถ้าเข้า Done ซ้ำ)
  sprintId              String?   // Sprint ที่ task นี้อยู่ — null ถ้ายังไม่ถูก pull-in หรือ pull-in ก่อนมี Sprint
  sprint                Sprint?   @relation(fields: [sprintId], references: [id])
  timeLogs      TimeLog[]
  taskLogs      TaskLog[]
  retroItems    RetroItem[]
  issueLogs     TaskIssueLog[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deletedAt])
  @@index([squadId, deletedAt])
  @@index([assigneeId, deletedAt])
  @@index([laneId])
  @@index([flaggedForDeletion])
  @@index([sprintId])
}

model TaskIssueLog {
  id             String    @id @default(cuid())
  taskId         String
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueNote      String
  flaggedById    String
  flaggedBy      User      @relation("IssueFlaggedBy", fields: [flaggedById], references: [id])
  flaggedAt      DateTime  @default(now())
  resolutionNote String?   // บังคับกรอกตอน unflag ผ่าน modal — null จนกว่าจะ resolve
  resolvedById   String?
  resolvedBy     User?     @relation("IssueResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  sprintId       String?
  sprint         Sprint?   @relation(fields: [sprintId], references: [id])
  createdAt      DateTime  @default(now())
}

model Sprint {
  id             String       @id @default(cuid())
  squadId        String
  squad          Squad        @relation(fields: [squadId], references: [id])
  name           String
  status         SprintStatus @default(OPEN)
  startedAt      DateTime     @default(now())
  plannedEndDate DateTime?
  closedAt       DateTime?
  closedById     String?
  closedBy    User?        @relation("SprintClosedBy", fields: [closedById], references: [id])
  tasks       Task[]
  issueLogs   TaskIssueLog[]
  createdAt   DateTime     @default(now())

  @@index([squadId, status])
}

model WeeklyReport {
  id              String   @id @default(cuid())
  squadId         String
  squad           Squad    @relation(fields: [squadId], references: [id])
  weekStart       DateTime
  weekEnd         DateTime
  generatedById   String
  generatedBy     User     @relation("WeeklyReportGeneratedBy", fields: [generatedById], references: [id])
  contentMarkdown String
  retroId         String?
  retro           Retro?   @relation(fields: [retroId], references: [id])
  createdAt       DateTime @default(now())
}

// บันทึกทุกครั้งที่มีการ import งานจาก Excel/CSV เพื่อ track ว่าใคร upload ไฟล์ไหนเมื่อไหร่
model ImportBatch {
  id         String   @id @default(cuid())
  fileName   String
  uploadedById String
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
  squadId    String?  // ถ้า import ระบุ squad ปลายทางไว้ล่วงหน้า
  squad      Squad?   @relation(fields: [squadId], references: [id])
  rowCount   Int      // จำนวนแถวที่ import สำเร็จ
  tasks      Task[]
  createdAt  DateTime @default(now())
}

model Retro {
  id        String        @id @default(cuid())
  squadId   String
  squad     Squad         @relation(fields: [squadId], references: [id])
  title     String        // เช่น "Retro Sprint 12"
  status    RetroStatus   @default(OPEN)
  items         RetroItem[]
  weeklyReports WeeklyReport[]
  createdAt     DateTime      @default(now())
  closedAt      DateTime?
}

// การ์ดใน retro แต่ละใบ (Went well / To improve / Action item)
model RetroItem {
  id           String        @id @default(cuid())
  retroId      String
  retro        Retro         @relation(fields: [retroId], references: [id], onDelete: Cascade)
  category     RetroCategory
  content      String
  authorId     String
  author       User          @relation(fields: [authorId], references: [id])
  votes        RetroVote[]
  // สำหรับ category = ACTION_ITEM สามารถผูกกับ Task จริงเพื่อติดตามต่อได้
  linkedTaskId String?
  linkedTask   Task?         @relation(fields: [linkedTaskId], references: [id])
  ownerId      String?       // ผู้รับผิดชอบ action item
  owner        User?         @relation("RetroItemOwner", fields: [ownerId], references: [id])
  createdAt    DateTime      @default(now())
}

// โหวต (1 คนโหวตซ้ำการ์ดเดิมไม่ได้ กันด้วย unique)
model RetroVote {
  id          String    @id @default(cuid())
  retroItemId String
  retroItem   RetroItem @relation(fields: [retroItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([retroItemId, userId])
  @@index([userId])
}

// แจ้งเตือน in-app (เช่น งานถูกลบ)
model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  message       String
  relatedTaskId String?
  relatedTask   Task?    @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  readAt        DateTime? // null = ยังไม่ได้อ่าน
  createdAt     DateTime @default(now())

  @@index([userId, readAt])
}

// บันทึก action ที่เกิดกับ task เช่น ลบเวลาทั้งหมด
model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // "TIME_CLEARED"
  detail    String?  // JSON string เก็บ context เช่น { deletedCount, totalNormalMin, totalOtMin }
  createdAt DateTime @default(now())

  @@index([taskId])
}

// บันทึกเวลาทำงานแต่ละช่วง (หยิบมาทำ -> จบ)
model TimeLog {
  id            String        @id @default(cuid())
  taskId        String
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  startAt       DateTime
  endAt         DateTime?     // null = timer ยังนับอยู่ (session เปิด)
  normalMinutes Int?          // คำนวณตอน stop เท่านั้น
  otMinutes     Int?
  source        TimeLogSource @default(AUTO) // AUTO = ลากการ์ด, MANUAL = กรอกเอง
  createdAt     DateTime      @default(now())

  @@index([taskId])
  @@index([userId])
}
